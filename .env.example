# Credentials for `npm run calendar`. Copy to `.env` and fill in — `.env` is
# gitignored, this template is not.
#
#     cp .env.example .env

# From Google Calendar → Settings and sharing → Integrate calendar → Calendar ID.
GOOGLE_CALENDAR_ID=

# A Google Cloud API key with the Calendar API enabled, restricted to that API.
# Required even for a public calendar: googleapis.com refuses unregistered
# callers, so the key is caller identity for quota, not permission to read.
GOOGLE_API_KEY=
